# ==============================================================================
# JALTRACKER Environment Configuration Template
# Copy this file to .env and customize values for production/local deployment.
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=waterbill
DB_USER=postgres
DB_PASS=root
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASS}

# JWT Authentication Secrets
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=rzp_test_JalTrackerDemoKey
RAZORPAY_KEY_SECRET=dummy_razorpay_secret_key_12345

# Message Broker (RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Distributed Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Dispatcher (SMTP / Mailtrap)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# Flyway Migrations
FLYWAY_ENABLED=true

# Twilio WhatsApp 2FA Verification (Twilio Sandbox / Live)
TWILIO_ACCOUNT_SID=AC_dummy_account_sid_12345
TWILIO_AUTH_TOKEN=dummy_auth_token_12345
TWILIO_PHONE_NUMBER=+14155238886
TWILIO_SERVICE_ID=
TWILIO_SIMULATION_MODE=true
