# ==========================================
# JALTRACKER Root .gitignore
# ==========================================

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
*.sublime-project
*.sublime-workspace

# Node & Frontend dependencies and outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
*.local

# Java & Maven build outputs
target/
backend/target/
*.class
*.jar
*.war
*.ear

# Logs & Crash Reports
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Secrets & Local Environment Configs
.env
.env*.local
frontend/.env
backend/.env
!.env.example
!backend/.env.example

# Temporary scratch and cache files
tmp/
temp/
.system_generated/
